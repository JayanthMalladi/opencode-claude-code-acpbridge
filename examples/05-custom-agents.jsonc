{
  // Define YOUR OWN injected agents (per model, per mode) in place of the built-in
  // ones. `options.mode` is the Claude Code session mode; `variant` is the effort.
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    { "package": "opencode-claude-code-acpbridge",
      "options": {
        "command": "claude-agent-acp",
        // This list REPLACES the built-in agents (claude-default, claude-plan, …).
        // Your agents get exactly the `options` you write here: they do NOT inherit the
        // built-in native profile (native subagents, skills, project memory…). Add those
        // options yourself if you want them, e.g. "nativeSkills": true.
        // Use "agents": false to inject none and declare every agent yourself in the
        // `agents` section of this file.
        "agents": {
          "cc-opus":   { "model": "default", "variant": "high", "options": { "mode": "default" } },
          "cc-sonnet": { "model": "sonnet",  "options": { "mode": "default" } },
          "cc-plan":   { "model": "default", "variant": "high", "options": { "mode": "plan" } }
        }
      } }
  ],
  // `mode: "primary"` (and permissions) go in OpenCode's own `agents` section:
  "agents": {
    "cc-opus":   { "mode": "primary" },
    "cc-sonnet": { "mode": "primary" },
    "cc-plan":   { "mode": "primary" }
  }
  // What you declare in `agents` wins over the plugin's definitions: the plugin only
  // fills `model` and `description` when they are missing.
  // To make OpenCode the only permission authority (no bridge for native tools), use
  // "options": { "mode": "bypassPermissions" } on an agent.
}
