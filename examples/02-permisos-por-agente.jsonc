{
  // Filtrar/controlar las herramientas del agente vía PERMISOS de OpenCode V2
  // (ruleset), sin tocar el código del plugin. Tu sección `agents` tiene
  // precedencia: declaras solo `permissions` y heredas model/options del plugin.
  // El ruleset también alimenta el PUENTE de permisos (reglas allow/deny
  // resuelven las tools nativas de Claude sin diálogo).
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    { "package": "opencode-claude-code-acpbridge", "options": { "command": "claude-agent-acp" } }
  ],
  "agents": {
    "claude-code": {
      // Read-only "duro": deniega escritura y shell, permite lectura/búsqueda/web.
      "permissions": [
        { "action": "edit",  "resource": "*", "effect": "deny" },
        { "action": "write", "resource": "*", "effect": "deny" },
        { "action": "bash",  "resource": "*", "effect": "deny" },
        { "action": "read",  "resource": "*", "effect": "allow" },
        { "action": "grep",  "resource": "*", "effect": "allow" },
        { "action": "glob",  "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" }
      ]
    },
    "claude-code-plan": {
      // El agente de plan: pedir confirmación para todo lo demás.
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "bash", "resource": "*", "effect": "ask" }
      ]
    }
  }
  // Nota: las tools se ejecutan en OpenCode; este ruleset es la forma
  // recomendada de acotarlas.
}
