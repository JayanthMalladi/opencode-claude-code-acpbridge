{
  // Permission bridge (OpenCode V2 only).
  //
  // The built-in `claude-code` agents keep a few NATIVE Claude Code tools that
  // OpenCode has no equivalent for: Skill, NotebookEdit, WebSearch, native subagents
  // (Task), MCP resource search, and ExitPlanMode. When Claude wants to use one of
  // them, Claude Code asks for permission, and the plugin answers like this:
  //
  //   1. Your rules first. A rule in `agents.<agent>.permissions` whose `action` is the
  //      native tool name decides with no dialog: `allow` runs it, `deny` blocks it.
  //      `resource` is matched against the tool's target (the skill name, the
  //      notebook path, the command…) and accepts globs.
  //   2. No matching rule → OpenCode shows a "Permission" dialog with
  //      `Allow once` / `Always allow` / `Deny`. "Always allow" is saved in
  //      `~/.acp-model-provider/always.json` and applies from then on.
  //   Anything unclear is treated as Deny (fail-closed).
  //
  // ExitPlanMode is special: leaving plan mode shows the plan with the choices Claude
  // Code itself offers (each one approves and sets the next session mode, or rejects
  // and keeps planning; typing your own answer sends it back as feedback).
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    { "package": "opencode-claude-code-acpbridge", "options": { "command": "claude-agent-acp" } }
  ],
  "agents": {
    "claude-code": {
      "permissions": [
        { "action": "Skill",        "resource": "*", "effect": "allow" },  // any skill: allow
        { "action": "WebSearch",    "resource": "*", "effect": "allow" },  // native web search: allow
        { "action": "NotebookEdit", "resource": "*", "effect": "ask" }     // editing Jupyter notebooks: ask
        // A catch-all `"action": "*"` rule is IGNORED by the bridge on purpose: OpenCode's
        // defaults contain `*: allow`, which would approve every native tool silently.
        // The bridge's default is already "ask" for any native tool without a rule.
        // The plugin adds `{ action: "question", resource: "*", effect: "allow" }` by
        // itself (the dialog runs through OpenCode's `question` tool): don't declare it.
      ]
    }
  }
  // To change WHICH native features an agent has (skills, native subagents, extra
  // native tools), you must define the agent yourself in the plugin's
  // `options.agents`. That list replaces the built-in agents: see 05-custom-agents.jsonc.
}
