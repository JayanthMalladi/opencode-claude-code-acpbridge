{
  // Control total: declaras el provider `acp` a mano en la config de OpenCode.
  // En V2 normalmente NO hace falta: con `options.command` el plugin
  // auto-registra el provider (V2 resuelve el paquete como `aisdk:<spec>`).
  // Declararlo a mano sirve para fijar modelos, costes y límites exactos, o en
  // entornos sin descubrimiento. El plugin DETECTA `provider.acp` declarado y
  // NO lo toca (guard nuevo).
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "acp": {
      "npm": "opencode-claude-code-acpbridge",   // en dev: RUTA DEL DIRECTORIO local (no `file://`)
      "name": "Claude Code (ACP)",
      "options": {
        "command": "claude-agent-acp",
        "claudeExecutable": "/home/usuario/.local/bin/claude",
        "claudeCode": { "systemPromptMode": "preset" }
      },
      "models": {
        "default": {
          "id": "default", "name": "Opus 4.7 (recommended)",
          "tool_call": true, "reasoning": true, "attachment": true,
          "limit": { "context": 1000000, "output": 64000 },
          "cost": { "input": 5, "output": 25, "cache_read": 0.5, "cache_write": 6.25 },
          "variants": { "low": {"effort":"low"}, "high": {"effort":"high"}, "max": {"effort":"max"} }
        },
        "sonnet": {
          "id": "sonnet", "name": "Sonnet 4.6",
          "tool_call": true, "reasoning": true, "attachment": true,
          "limit": { "context": 1000000, "output": 64000 },
          "cost": { "input": 3, "output": 15, "cache_read": 0.3, "cache_write": 3.75 }
        },
        "haiku": { "id": "haiku", "name": "Haiku 4.5", "tool_call": true, "reasoning": true }
      }
    }
  },
  // El plugin se sigue cargando para inyectar los agentes y el context hook
  // (`session.hook("context")`: sessionID/resume + options por agente);
  // como `provider.acp` ya existe, no lo reescribe.
  "plugins": [
    { "package": "opencode-claude-code-acpbridge", "options": { "command": "claude-agent-acp" } }
  ]
}
