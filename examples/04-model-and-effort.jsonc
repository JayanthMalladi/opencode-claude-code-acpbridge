{
  // Choose the model and the reasoning effort (OpenCode V2 only).
  //
  // The effort is a VARIANT of the model: in the TUI you pick e.g. "acp/default#max"
  // or "acp/haiku#low" (V2 syntax `provider/model#variant`). Available efforts:
  // low, medium, high, xhigh, max (only on models that expose effort levels).
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    { "package": "opencode-claude-code-acpbridge",
      "options": {
        "command": "claude-agent-acp",
        "claudeCode": {
          // Defaults for every use of the provider, when the agent/variant doesn't set them:
          "effort": "high",
          // Setting `thinking` replaces the default ({type:"enabled", display:"summarized"}).
          // Keep `display: "summarized"`, or the reasoning block stops showing in OpenCode.
          "thinking": { "type": "enabled", "budgetTokens": 16000, "display": "summarized" }
        }
      } }
  ],
  "agents": {
    // Maximum quality for the built-in agent: Opus with the maximum effort.
    "claude-default": { "model": "acp/default#max" },
    // A fast extra agent, declared in OpenCode's own `agents` section: Haiku with low
    // effort. It runs on the acp provider with the plain profile (OpenCode's tools, no
    // native Claude Code extras such as skills or native subagents). An agent configured
    // with an `acp/…` model counts as a Claude Code agent for the model pairing.
    "claude-fast": {
      "description": "Fast Claude Code (Haiku, low effort)",
      "mode": "primary",
      "model": "acp/haiku#low"
    }
  }
  // Don't add agents through the plugin's `options.agents` just to get an extra one:
  // that list REPLACES the built-in claude-<mode> agents (see 05-custom-agents.jsonc).
}
