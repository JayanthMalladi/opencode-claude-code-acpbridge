{
  // Full control: declare the `acp` provider yourself in OpenCode's config.
  // Normally you DON'T need this: with `options.command` the plugin registers the
  // provider on its own (with the models Claude Code reports and their metadata).
  // Declaring it by hand is for pinning the settings, names, costs and limits of the
  // models you list, or for setups where discovery can't run. When `acp` is already
  // declared, the plugin doesn't register its own definition. In OpenCode 2.1.1 the
  // values you set here win, and models or variants you don't list still show up
  // from discovery: this pins values, it doesn't hide models.
  //
  // This uses the native OpenCode V2 `providers` format. (V2 still accepts the old V1
  // `provider` block with `npm`/`options`, but migrates it and drops unknown fields.)
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "acp": {
      "name": "Claude Code (ACP)",
      // `aisdk:` + the npm package. For local development use the built entry point:
      // "aisdk:file:///path/to/opencode-claude-code-acpbridge/dist/index.js"
      "package": "aisdk:opencode-claude-code-acpbridge",
      // Passed to the provider factory (same keys as the plugin options below).
      "settings": {
        "command": "claude-agent-acp",
        "claudeExecutable": "/home/you/.local/bin/claude",
        "claudeCode": { "systemPromptMode": "preset" }
      },
      "models": {
        "default": {
          "name": "Opus (recommended)",
          "capabilities": { "tools": true },
          "limit": { "context": 1000000, "output": 64000 },
          "cost": { "input": 5, "output": 25, "cache": { "read": 0.5, "write": 6.25 } },
          // Effort levels as variants: picking "acp/default#high" sends { effort: "high" }.
          "variants": [
            { "id": "low",  "settings": { "effort": "low" } },
            { "id": "high", "settings": { "effort": "high" } },
            { "id": "max",  "settings": { "effort": "max" } }
          ]
        },
        "sonnet": {
          "name": "Sonnet",
          "capabilities": { "tools": true },
          "limit": { "context": 200000, "output": 64000 },
          "cost": { "input": 3, "output": 15, "cache": { "read": 0.3, "write": 3.75 } }
        },
        "haiku": { "name": "Haiku", "capabilities": { "tools": true } }
      }
    }
  },
  // Keep loading the plugin: it injects the agents and passes the per-call context
  // (session link, resume data, per-agent options). Since `acp` already exists, it
  // doesn't overwrite it.
  "plugins": [
    { "package": "opencode-claude-code-acpbridge", "options": { "command": "claude-agent-acp" } }
  ]
}
