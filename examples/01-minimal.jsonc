{
  // Minimal config (OpenCode V2 only). The plugin asks Claude Code which models it
  // offers, registers the `acp` provider with them, and adds one agent per Claude
  // Code mode: `claude-default`, `claude-plan`, `claude-acceptedits`, `claude-auto`,
  // `claude-dontask`, `claude-bypasspermissions`. The `acp/…` models are reserved for
  // those agents (`pairModels`). Usage counts against your Claude
  // SUBSCRIPTION (systemPromptMode "preset" is the default).
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    { "package": "opencode-claude-code-acpbridge", "options": { "command": "claude-agent-acp" } }
  ]
  // How to use it: in the TUI pick the "claude-default" agent (it brings the
  // "acp/default" model). From the command line:
  //   opencode run --agent claude-default -m acp/default "…"
  // If the `claude` binary is not found automatically, add to "options":
  //   "claudeExecutable": "/path/to/claude"
  // Local development: "package" can be the DIRECTORY of your checkout instead of
  // the npm name (build it first with `npm run build`; the root `index.js` is the
  // entry point OpenCode loads from a directory).
}
