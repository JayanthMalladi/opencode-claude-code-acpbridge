{
  // Config mínima. El plugin descubre los modelos del agente y registra el
  // provider `acp` + los agentes `claude-code` y `claude-code-plan`.
  // Consume de tu SUSCRIPCIÓN (systemPromptMode "preset" por defecto).
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ["opencode-claude-code-acpbridge", { "command": "claude-agent-acp" }]
  ]
  // Úsalo: en la TUI elige el agente "claude-code", o el modelo "acp/default".
  // Si la autodetección del binario falla, añade dentro de las opciones:
  //   "claudeExecutable": "/ruta/a/claude"
}
