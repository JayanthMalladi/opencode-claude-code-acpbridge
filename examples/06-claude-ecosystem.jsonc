{
  // Advanced: instead of the "clean brain", let Claude Code load more of YOUR real
  // Claude Code setup — settings, hooks and agents from ~/.claude and the project,
  // plus the MCP servers and claude.ai connectors bound to your account.
  //
  // ⚠️ Implications:
  //  - settingSources loads settings (hooks, agents, skills) from user/project/local.
  //  - strictMcpConfig:false lets through MCP servers from ~/.claude.json and the
  //    claude.ai connectors (Gmail, Drive, Notion…) as extra native tools.
  //  - If those hooks/agents add an aggressive system prompt of their own, the session
  //    may be billed as EXTRA USAGE (like append/replace). Check with ACP_DEBUG=1.
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    { "package": "opencode-claude-code-acpbridge",
      "options": {
        "command": "claude-agent-acp",
        "claudeCode": {
          // Already the default: Claude Code keeps its state in your ~/.claude, so sessions
          // can be resumed with `claude --resume <id>`. "isolated" would use a clean dir instead.
          "configDir": false,
          "settingSources": ["user", "project"],   // load settings (hooks/agents/skills)
          "strictMcpConfig": false                 // let ~/.claude.json MCP servers and claude.ai connectors in
          // Native file/shell tools (Bash, Read, Write, Edit…) stay disabled on the built-in
          // agents on purpose: OpenCode runs those, so everything stays in its history.
        }
      } }
  ]
}
