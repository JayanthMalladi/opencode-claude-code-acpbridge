{
  // Use case: you want Claude to FOLLOW OpenCode's system prompt and agents (for
  // example your "build" agent with your own instructions) instead of behaving
  // like native Claude Code.
  //
  // ⚠️ COST: forwarding OpenCode's system prompt makes Anthropic treat the session
  // as a third-party app, so it is billed as EXTRA USAGE (paid), not against your
  // subscription. Only use this if you accept that.
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    { "package": "opencode-claude-code-acpbridge",
      "options": {
        "command": "claude-agent-acp",
        "claudeCode": {
          "systemPromptMode": "append"   // "append" (Claude Code preset + OpenCode's) or "replace" (OpenCode's only)
        }
      } }
  ]
  // With this, any OpenCode agent that uses an acp/* model follows its own system
  // prompt. To go back to the subscription, remove systemPromptMode (default "preset").
}
