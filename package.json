{
  "name": "opencode-claude-code-acpbridge",
  "version": "0.11.0",
  "description": "Use Claude Code inside OpenCode. An OpenCode plugin + model provider that bridges Claude Code over ACP (Agent Client Protocol): run it on your Claude subscription while OpenCode orchestrates the tools, permissions and TUI.",
  "license": "MIT",
  "author": "Antonio Orizondo Leyva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aorizondo/opencode-claude-code-acpbridge.git"
  },
  "homepage": "https://github.com/aorizondo/opencode-claude-code-acpbridge#readme",
  "bugs": {
    "url": "https://github.com/aorizondo/opencode-claude-code-acpbridge/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "claude",
    "anthropic",
    "acp",
    "agent-client-protocol",
    "ai-sdk",
    "language-model",
    "provider",
    "opencode-v2",
    "claude-subscription"
  ],
  "engines": {
    "node": ">=18",
    "opencode": ">=2.0.14"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-claude-code-acpbridge": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm test && npm run check:install",
    "test": "tsc && node --test --test-timeout=20000 \"test/*.test.mjs\"",
    "check:install": "node scripts/check-install.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@mcpc-tech/acp-ai-provider": "^0.3.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.21",
    "@types/node": "^25.8.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@opencode/plugin": "^2.0.14",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
