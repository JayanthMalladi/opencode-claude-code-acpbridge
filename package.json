{
  "name": "opencode-claude-code-acpbridge",
  "version": "0.7.0",
  "description": "Use Claude Code inside OpenCode. An OpenCode plugin + model provider that bridges Claude Code over ACP (Agent Client Protocol): run it on your Claude subscription while OpenCode orchestrates the tools, permissions and TUI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-claude-code-acpbridge": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "claude",
    "anthropic",
    "acp",
    "agent-client-protocol",
    "ai-sdk",
    "language-model",
    "provider"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.14.1",
    "@mcpc-tech/acp-ai-provider": "^0.3.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.17.9",
    "@types/node": "^25.8.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "ai": "^6.0.0"
  }
}
